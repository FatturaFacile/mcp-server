# Ignore patterns for AI tooling and indexers in fatturafacile-mcp-server

# Dependencies & package managers
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build and compilation outputs
dist/
build/
out-tsc/
*.tsbuildinfo

# Documentation generator output (Typedoc)
docs/api/

# Test and coverage artifacts
coverage/
.vitest/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Agent sandboxing, scratch, & local state
.sandbox/
.claude-build/
.claude/settings.local.json
.claude/*.local.md
.claude/worktrees/
*.tmp

# Secrets, credentials & local environment files
.env
.env.*
!.env.example
auth.json
certs/
*.pem
*.key
*.pfx

# Local databases and logs
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log
logs/

# IDE & system metadata
.idea/
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.DS_Store
Thumbs.db
