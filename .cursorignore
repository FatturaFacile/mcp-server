# Ignore list shared by every AI tool in this repository (gitignore syntax).
# Kept identical across: .aiignore, .claudeignore, .agyignore, .copilotignore, .cursorignore

# Dependencies and package managers
node_modules/
.pnpm-store/

# Build and compilation outputs
dist/
build/
out-tsc/
*.tsbuildinfo

# Test and coverage artifacts
coverage/
.vitest/
test-results/
playwright-report/
blob-report/

# Documentation generator output (Typedoc)
docs/api/

# Secrets, credentials and environment files (NEVER read or commit)
.env
.env.*
!.env.example
auth.json
certs/
*.pem
*.key
*.pfx

# Local databases and logs
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log
logs/

# Ephemeral scratch, sandboxing and system files
.sandbox/
.claude/worktrees/
.DS_Store
Thumbs.db
*.tmp

# Media and binary token sinks
*.pdf
*.zip
*.tar.gz
*.png
*.jpg
*.jpeg
*.ico
