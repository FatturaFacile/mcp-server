{
  "compactThresholdPercent": 50,
  "maxBashOutputChars": 15000,
  "permissions": {
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/build/**)",
      "Read(./**/coverage/**)",
      "Read(./**/test-results/**)",
      "Read(./**/playwright-report/**)",
      "Read(./**/docs/api/**)",
      "Read(./**/.env*)",
      "Read(./**/auth.json)",
      "Read(./**/certs/**)"
    ]
  }
}
