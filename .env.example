# Server Environment Configuration
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# MCP Transport Configuration
# Options: stdio | streamable-http | sse
MCP_TRANSPORT=stdio

# Fattura Facile ERP API Configuration
FATTURA_FACILE_API_URL=https://api.fatturafacile.eu
FATTURA_FACILE_API_KEY=your_erp_api_key_here

# Redis Cache and Queue Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=300

# Security & Authentication
API_KEY_HEADER=X-API-Key
JWT_SECRET=super_secret_jwt_key_min_32_characters_long
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# OpenTelemetry Observability
OTEL_SERVICE_NAME=fatturafacile-mcp-server
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
